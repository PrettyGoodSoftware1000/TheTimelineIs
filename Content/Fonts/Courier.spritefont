<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <!-- Courier Prime (SIL OFL) — committed in this folder so the build is
         identical on every machine; no system font dependency. -->
    <FontName>CourierPrime-Regular.ttf</FontName>
    <!-- Baked large (design res is 4K) and scaled DOWN in code; scaling up blurs. -->
    <Size>96</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <DefaultCharacter>?</DefaultCharacter>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <CharacterRegion>
        <!-- the middot, used as a separator in prompts -->
        <Start>&#183;</Start>
        <End>&#183;</End>
      </CharacterRegion>
      <CharacterRegion>
        <!-- en and em dash: the editor's own text is full of them, and
             without this every one of them drew as a question mark -->
        <Start>&#8211;</Start>
        <End>&#8212;</End>
      </CharacterRegion>
      <CharacterRegion>
        <!-- the infinity sign, for something whose nerve cannot be broken -->
        <Start>&#8734;</Start>
        <End>&#8734;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
