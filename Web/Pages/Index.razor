@page "/"
@page "/index.html"
@inject IJSRuntime JsRuntime
@inject HttpClient Http

<PageTitle>The Timeline Is</PageTitle>

<div id="canvasHolder" style="background: #000; position: fixed; inset: 0; width: 100vw; height: 100vh;">
    <canvas id="theCanvas" style="touch-action:none;"></canvas>
</div>

@if (!_loaded)
{
    <div class="loading">
        <div class="loading-title">The Timeline Is</div>
        <div class="loading-bar"><div style="width: @(_percent)%"></div></div>
        <div class="loading-note">Loading art&hellip; @_status</div>
    </div>
}
